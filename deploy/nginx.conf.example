# Place in nginx's http context (for example /etc/nginx/conf.d/zhiban.conf).
# Add your domain's HTTPS certificate/443 listener before publishing online.
limit_req_zone $binary_remote_addr zone=zhiban_auth:10m rate=5r/s;
server {
    listen 80;
    server_name learn.example.com;
    client_max_body_size 256k;

    location ~ ^/api/(login|register)$ {
        limit_req zone=zhiban_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }
}
